{
  "mcpServers": {
    "linear": {
      "type": "http",
      "enabled": false,
      "url": "https://mcp.linear.app/mcp"
    },
    "gitlab": {
      "type": "http",
      "enabled": true,
      "url": "https://gitlab.com/api/v4/mcp"
    },
    "atlassian": {
      "type": "http",
      "enabled": true,
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "microsoft-learn": {
      "type": "http",
      "enabled": true,
      "url": "https://learn.microsoft.com/api/mcp",
      "auth": "none"
    },
    "chrome-devtools": {
      "type": "stdio",
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}